<?xml version="1.0"?>
<ruleset
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
	name="MDG"
>
	<description>Matchbox Design Group PHP standard: WordPress Coding Standards plus PHP compatibility checks.</description>

	<!--
	Used by the org lint workflow when a repository has no phpcs config of its own.
	A repository can also build on it with <rule ref="MDG"/>; see
	standards/phpcs/phpcs.xml.dist.example.
	-->

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<!-- Third-party, generated and WordPress core code. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/wp-admin/*</exclude-pattern>
	<exclude-pattern>*/wp-includes/*</exclude-pattern>
	<exclude-pattern>*/wp-content/uploads/*</exclude-pattern>
	<exclude-pattern>*/wp-content/upgrade/*</exclude-pattern>
	<exclude-pattern>*/web/wp/*</exclude-pattern>
	<exclude-pattern>*.min.php</exclude-pattern>

	<!-- Lowest PHP and WordPress versions our sites support. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="WordPress">
		<!-- Short array syntax [] is allowed (and used across our themes). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
