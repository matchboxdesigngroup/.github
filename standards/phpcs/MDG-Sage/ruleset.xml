<?xml version="1.0"?>
<ruleset
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
	name="MDG-Sage"
>
	<description>Matchbox Design Group PHP standard for Roots/Sage and other Pint-formatted WordPress code: WordPress security, database and API checks plus PHP compatibility checks, without WordPress formatting or naming rules.</description>

	<!--
	Used by the org lint workflow with php-standard: sage, alongside Pint, which
	handles code style the way Sage ships it. Pint and these rules don't overlap.
	A repository can also build on it with <rule ref="MDG-Sage"/>.
	-->

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<!-- Third-party, generated and WordPress core code. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/public/*</exclude-pattern>
	<exclude-pattern>*/storage/*</exclude-pattern>
	<exclude-pattern>*/web/wp/*</exclude-pattern>
	<exclude-pattern>*/wp-admin/*</exclude-pattern>
	<exclude-pattern>*/wp-includes/*</exclude-pattern>
	<!-- Blade escapes {{ }} output itself, and PHPCS can't parse Blade. -->
	<exclude-pattern>*.blade.php</exclude-pattern>

	<!-- Lowest PHP and WordPress versions our sites support. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.2"/>

	<!-- Escaping, sanitizing, nonces and safe redirects. -->
	<rule ref="WordPress.Security"/>

	<!-- Prepared SQL, and WordPress APIs over direct queries and PHP functions. -->
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.DiscouragedFunctions"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="Generic.PHP.BacktickOperator"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
